  "steps": [
    {
      "position": 0,
      "body": "Preheat oven to 200°F (95°C).",
      "duration_min": null
    },
    {
      "position": 1,
      "body": "Set a wire rack in a baking sheet; set aside.",
      "duration_min": null
    },
    {
      "position": 2,
      "body": "In a large, wide bowl or pie plate, whisk eggs to blend.",
      "duration_min": null
    },
    {
      "position": 3,
      "body": "Whisk in milk, granulated sugar, vanilla, cinnamon, and salt until combined.",
      "duration_min": null
    },
    {
      "position": 4,
      "body": "Add 2 bread slices to egg mixture and let soak, partially submerged, until bottom half of bread is saturated, about 30 seconds.",
      "duration_min": 1
    },
    {
      "position": 5,
      "body": "Using a fork, flip bread and soak 30 seconds longer.",
      "duration_min": 1
    },
    {
      "position": 6,
      "body": "In a large skillet over medium heat, heat 1 teaspoon butter and 1 teaspoon oil just until butter starts to bubble.",
      "duration_min": null
    },
    {
      "position": 7,
      "body": "Add soaked bread and cook until golden brown and crisp on both sides, about 3 minutes per side.",
      "duration_min": 6
    },
    {
      "position": 8,
      "body": "Transfer French toast to reserved rack and place in oven to stay warm.",
      "duration_min": null
    },
    {
      "position": 9,
      "body": "Repeat with remaining butter, oil, and bread.",
      "duration_min": null
    },
    {
      "position": 10,
      "body": "Divide French toast among plates.",
      "duration_min": null
    },
    {
      "position": 11,
      "body": "Serve with more butter and maple syrup alongside.",
      "duration_min": null
    }
  ]
