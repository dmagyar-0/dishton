  "steps": [
    {
      "position": 0,
      "body": "Heat oven to 190°C (375°F), or 170°C (340°F) for a fan oven, gas 5.",
      "duration_min": null
    },
    {
      "position": 1,
      "body": "Butter the base and sides of two 20cm round sandwich tins and line the bases with baking parchment.",
      "duration_min": null
    },
    {
      "position": 2,
      "body": "In a large bowl, beat together 200g golden caster sugar, 200g softened unsalted butter, 4 large eggs, 200g self-raising flour, 2 tbsp cocoa powder, 1 tsp baking powder, ½ tsp vanilla extract, 2 tbsp milk and a pinch of salt until pale.",
      "duration_min": null
    },
    {
      "position": 3,
      "body": "Divide the mixture between the prepared tins.",
      "duration_min": null
    },
    {
      "position": 4,
      "body": "Bake for 20 mins or until a skewer inserted into the centre of the cake comes out clean.",
      "duration_min": 20
    },
    {
      "position": 5,
      "body": "Leave to cool in the tin for 10 mins.",
      "duration_min": 10
    },
    {
      "position": 6,
      "body": "Turn out onto a wire rack to cool completely.",
      "duration_min": null
    },
    {
      "position": 7,
      "body": "For the buttercream, put 100g chopped milk chocolate in a heatproof bowl and melt in the microwave, stirring every 30 secs.",
      "duration_min": null
    },
    {
      "position": 8,
      "body": "Leave the melted chocolate to cool for 5 mins.",
      "duration_min": 5
    },
    {
      "position": 9,
      "body": "Mash 200g softened butter and 400g icing sugar together with a fork, then switch to a wooden spoon or electric beaters, if you have them.",
      "duration_min": null
    },
    {
      "position": 10,
      "body": "Sift in 5 tbsp cocoa powder with a pinch of salt.",
      "duration_min": null
    },
    {
      "position": 11,
      "body": "Pour in the melted chocolate and 2 tbsp milk, then mix again until smooth.",
      "duration_min": null
    },
    {
      "position": 12,
      "body": "On a cake stand or large plate, sandwich the cakes together with half of the buttercream, then spread the rest on top.",
      "duration_min": null
    },
    {
      "position": 13,
      "body": "Decorate with chocolate shards, if you like.",
      "duration_min": null
    },
    {
      "position": 14,
      "body": "To make chocolate shards: melt 50g dark chocolate and pour it onto a tray lined with baking parchment or foil.",
      "duration_min": null
    },
    {
      "position": 15,
      "body": "Now melt 25g milk chocolate and 25g white chocolate and drizzle them over the dark chocolate before it sets.",
      "duration_min": null
    },
    {
      "position": 16,
      "body": "Shake the tray gently to level the mixture, then leave to set somewhere cool.",
      "duration_min": null
    },
    {
      "position": 17,
      "body": "Chop into shards.",
      "duration_min": null
    }
  ]
}
