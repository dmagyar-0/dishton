  "steps": [
    {
      "position": 0,
      "body": "Put all the ingredients except the oil into a blender and blend until smooth, or whisk together in a large bowl.",
      "duration_min": null
    },
    {
      "position": 1,
      "body": "Leave the batter to sit for a couple of minutes.",
      "duration_min": 2
    },
    {
      "position": 2,
      "body": "Heat the oil in a large non-stick frying pan on a medium heat until it's warm.",
      "duration_min": null
    },
    {
      "position": 3,
      "body": "Pour 5 to 8 tablespoons of batter into the pan per pancake and don't spread them out.",
      "duration_min": null
    },
    {
      "position": 4,
      "body": "When bubbles or air pockets start to appear and the top of the pancake starts to dry out, it's time to turn them (a small silicone spatula will help to flip them).",
      "duration_min": null
    },
    {
      "position": 5,
      "body": "Turn your pancakes over and cook for 1 minute more, until golden.",
      "duration_min": 1
    },
    {
      "position": 6,
      "body": "Pancakes are very plain on their own, so get creative with toppings. Typical toppings include a dollop of non-dairy yoghurt, fruit compote or stewed fruit, fresh fruit or berries or caramelized banana, and don't forget a generous drizzle of maple syrup or your favourite sweetener.",
      "duration_min": null
    }
